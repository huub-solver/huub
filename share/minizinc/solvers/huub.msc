{
  "name" : "Huub",
  "version": "0.1.0",
  "id": "solutions.huub",
  "tags": ["int", "bool", "sat", "lcg"],
  "inputType": "JSON",
  "executable": "../../fzn-huub",
  "mznlib": "../huub",
  "stdFlags": ["-a", "-i", "-f", "-s", "-t", "-v"],
  "extraFlags": [
    ["--output-solutions", "Whether to output solutions", "bool:false:true", "true],
    ["--restart","whether to enable restarts during search","bool:false:true","false"],
    ["--int-eager-limit", "Set the maximum cardinality for which all order literals to represent an integer variable are created eagerly", "int", 255],
    ["--toggle-vsids", "Alternate between the activity-based search heuristic and the user-specific search heuristic after every restart.", "bool", "false"],
    ["--preprocessing","whether to enable preprocessing techniques","bool:false:true","false"],
    ["--inprocessing","whether to enable inprocessing techniques","bool:false:true","false"],
    ["--vivify","whether to enable vivification","bool:false:true","false"],
    ["--subsumption","whether to enable the global forward subsumption","bool:false:true","false"],
    ["--variable-elimination","whether to enable the bounded variable elimination ","bool:false:true","false"],
    ["--probing","whether to enable the failed literal probing","bool:false:true","false"],
    ["--conditioning","whether to enable the globally blocked clause elimination","bool:false:true","false"],
    ["--vsids-after", "Switch to activity-based search heuristic provided by the SAT solver after the given number of conflicts.", "int", "0"],
    ["--vsids-only", "Only use the activity-based search provided by the SAT solver", "bool", "false"],
    ["--forward-explanation", "Whether to use forward explanation for CP propagators", "bool", "false"],
    ["--forward-limit", "the number of literals in an explanation at which the engine forwards explanations to the SAT solver as external clauses.", "int", "1"]
  ]
}
