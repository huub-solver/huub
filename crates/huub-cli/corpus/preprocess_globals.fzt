var bool: p;
var bool: q;
var bool: r;
var bool: s;
var 1..3: x;
var 1..3: y;
var 1..3: z;
constraint huub_all_different_int([x, y, z]) :: trace_id(6);
constraint huub_table_int([x, y], [1, 2, 2, 3, 3, 1]) :: trace_id(7);
constraint bool_clause([p, q], [r]) :: trace_id(8);
constraint array_bool_and([p, q], s) :: trace_id(9);
constraint bool_xor(q, r) :: trace_id(10);
psi p := p;
psi q := q;
psi r := r;
psi s := s;
psi x := x;
psi y := y;
psi z := z;
solve satisfy;
